{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileStorage": {
    "BasePath": "uploads"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "DocumentParsedConsumer": {
      "MaxProcessingAttempts": 3,
      "RetryBaseDelaySeconds": 5,
      "DeadLetterTopic": "document.parsed.dlq"
    }
  },
  "Tei": {
    "BaseUrl": "http://localhost:8080",
    "TimeoutSeconds": 120,
    "BatchSize": 16,
    "MaxRetries": 3,
    "RetryBaseDelayMilliseconds": 500
  },
  "LiteLLM": {
    "BaseUrl": "http://localhost:4000",
    "Model": "command-a-plus",
    "ApiKey": "sk-1234"
  },
  "AllowedHosts": "*"
}
